# PhotoGear Backend Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Django Settings
# ============================================

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=django-insecure-change-this-in-production

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,photogear-backend

# ============================================
# Database Configuration
# ============================================

# Database engine (sqlite3 for development, postgresql for production)
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql

# SQLite: path to database file (e.g., db.sqlite3)
# PostgreSQL: database name
DB_NAME=db.sqlite3
# DB_NAME=photogear

# PostgreSQL only
DB_USER=
# DB_USER=photogear_user

DB_PASSWORD=
# DB_PASSWORD=photogear_pass

DB_HOST=
# DB_HOST=db

DB_PORT=
# DB_PORT=5432

# ============================================
# Logging Configuration
# ============================================

# Application level: Development, Staging, Production
APPLICATION_LEVEL=Development

# Enable request/function tracing
ENABLE_TRACING=True

# Enable logging to files
ENABLE_FILE_LOGGING=True

# Ignore traces without IDs
IGNORE_NAN_TRACE=False

# ============================================
# JWT Authentication
# ============================================

# JWT secret key (defaults to SECRET_KEY if not set)
# JWT_SECRET_KEY=your-jwt-secret-key

# JWT algorithm
# JWT_ALGORITHM=HS256

# JWT access token lifetime in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# JWT refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# AWS Configuration
# ============================================
# AWS Credential Mode:
# - Set USE_AWS_ROLE=true when running on AWS (ECS, EC2, Lambda)
#   This uses ECS Task Role / IAM Instance Profile automatically
#   (RECOMMENDED for AWS deployments)
# - Set USE_AWS_ROLE=false (or leave unset) for local development
#   This uses explicit credentials below
USE_AWS_ROLE=false

# AWS Credentials (only used when USE_AWS_ROLE=false)
# When running on AWS with Task Role, these are ignored
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS S3 Configuration
AWS_S3_REGION_NAME=eu-north-1
AWS_STORAGE_BUCKET_NAME=photogear-storage-bucket
AWS_S3_RAW_IMAGES_BUCKET=photogear-raw-images-bucket
AWS_S3_AI_BUCKET=photogear-ai-bucket
AWS_S3_RESULTS_BUCKET=photogear-results-bucket
AWS_S3_ENDPOINT_URL=https://s3.eu-north-1.amazonaws.com

# ============================================
# AI Service Integration
# ============================================
AI_GATEWAY_URL=http://localhost:8080
AI_GATEWAY_SECRET_KEY=your-ai-gateway-secret-key

# ============================================
# Redis Configuration
# ============================================

# Option 1: Full Redis URL (takes priority over host/port/db)
# Useful for managed Redis (ElastiCache, Redis Cloud, etc.)
# REDIS_URL=redis://user:password@redis-host:6379/0

# Option 2: Individual components (used when REDIS_URL is not set)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# Celery Configuration
# ============================================
# Defaults to the Redis connection above if not explicitly set
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret

# ============================================
# API Configuration
# ============================================

# Default pagination page size
PAGE_SIZE=100

# ============================================
# Docker/Production Settings
# ============================================

# PostgreSQL configuration for Docker Compose
POSTGRES_DB=photogear
POSTGRES_USER=photogear_user
POSTGRES_PASSWORD=photogear_pass

# ============================================
# Static Files
# ============================================

# Static files directory
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles/

# ============================================
# CORS Settings (if needed)
# ============================================

# Allow all origins (NOT recommended for production)
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated list of allowed origins (used when CORS_ALLOW_ALL_ORIGINS=False)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Dataset File Extensions
# ============================================

# Comma-separated allowed image extensions
# DATASET_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.tif,.webp,.bmp,.gif,.dng

# Comma-separated allowed metadata extensions
# DATASET_METADATA_EXTENSIONS=.nav,.obs,.mrk,.bin,.pos,.csv,.txt,.log,.rtcm,.ubx,.rinex,.json,.xml
