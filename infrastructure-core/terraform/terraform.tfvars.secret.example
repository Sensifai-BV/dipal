# This is an example file for sensitive variables
# Copy this file to terraform.tfvars.secret and fill in the actual values
# DO NOT commit terraform.tfvars.secret to version control

# Note: Most secrets are managed via AWS Secrets Manager and SSM Parameter Store
# This file is for reference only - you'll update secrets directly in AWS after deployment

# After running 'terraform apply', update the following secrets in AWS Secrets Manager:
#
# 1. Django SECRET_KEY:
#    aws secretsmanager update-secret --secret-id photogear/production/secret-key \
#      --secret-string "your-actual-django-secret-key-here"
#
# 2. AWS Access Key ID (for S3 access from Django):
#    aws secretsmanager update-secret --secret-id photogear/production/aws-access-key-id \
#      --secret-string "your-aws-access-key-id"
#
# 3. AWS Secret Access Key:
#    aws secretsmanager update-secret --secret-id photogear/production/aws-secret-access-key \
#      --secret-string "your-aws-secret-access-key"
#
# 4. AI Service Secret Key:
#    aws secretsmanager update-secret --secret-id photogear/production/ai-service-secret-key \
#      --secret-string "your-ai-service-api-key"
#
# 5. Database password (automatically generated, retrieve with):
#    aws secretsmanager get-secret-value --secret-id photogear/production/db-password \
#      --query SecretString --output text
#
# 6. S3 KMS Key ID (automatically created, retrieve with):
#    aws secretsmanager get-secret-value --secret-id photogear/production/s3-kms-key-id \
#      --query SecretString --output text

# Update the following SSM Parameters:
#
# 1. Allowed Hosts (comma-separated):
#    aws ssm put-parameter --name /photogear/production/allowed-hosts \
#      --value "yourdomain.com,www.yourdomain.com" --type String --overwrite
#
# 2. CORS Allowed Origins (comma-separated):
#    aws ssm put-parameter --name /photogear/production/cors-allowed-origins \
#      --value "https://yourdomain.com,https://www.yourdomain.com" --type String --overwrite

# The following values are automatically populated by Terraform:
# - DB_HOST, DB_PORT, DB_NAME, DB_USER (from RDS)
# - AWS_STORAGE_BUCKET_NAME, AWS_S3_REGION_NAME (from S3)
# - CELERY_BROKER_URL, CELERY_RESULT_BACKEND (from Redis)
