# ==============================================
# PhotoGear Image Analysis Core Configuration
# ==============================================
# Copy this file to .env and fill in your values.
# All variable names are CASE-INSENSITIVE in code.

# ==============================================
# Docker-Compose Volume Configuration
# ==============================================
# Host path mounted as /app in containers (use . for local dev)
HOST_APP_PATH=.
# Named volume for shared processing data between services
SHARED_DATA_VOLUME=shared_processing_data
# Named volume for Redis data persistence
REDIS_DATA_VOLUME=redis_data

# ==============================================
# Docker-Compose CPU Limits (per service)
# ==============================================
# Number of CPU cores each container can use.
# Default is 7 (total cores minus 1, to leave headroom for the host).
API_GATEWAY_CPUS=7
CALIBRATION_CPUS=7
SFM_CPUS=7
ORTHOMOSAIC_CPUS=7

# ==============================================
# Docker-Compose Service Ports
# ==============================================
# Used by docker-compose.yml to expose host ports.
API_GATEWAY_PORT=8080
CALIBRATION_SERVICE_PORT=8001
SFM_SERVICE_PORT=8002
ORTHOMOSAIC_SERVICE_PORT=8003

# ==============================================
# Service URLs
# ==============================================
# Full URLs — do NOT use host:port separately.
# Supports http, https, or any scheme.
API_GATEWAY_URL=http://api_gateway:8080

# Service client URLs (used by API Gateway to reach processing services)
# Only required when DISPATCH_MODE=http. Ignored when DISPATCH_MODE=sqs.
CALIBRATION_CLIENT_ADDRESS=http://calibration:8001
SFM_CLIENT_ADDRESS=http://sfm:8002
ORTHOMOSAIC_CLIENT_ADDRESS=http://orthomosaic_generation:8003

# Client timeout and retry settings (per-service, optional)
# CALIBRATION_CLIENT_TIMEOUT_SECONDS=30
# CALIBRATION_CLIENT_MAX_RETRIES=3
# CALIBRATION_CLIENT_RETRY_DELAY_SECONDS=2
# SFM_CLIENT_TIMEOUT_SECONDS=30
# SFM_CLIENT_MAX_RETRIES=3
# SFM_CLIENT_RETRY_DELAY_SECONDS=2
# ORTHOMOSAIC_CLIENT_TIMEOUT_SECONDS=30
# ORTHOMOSAIC_CLIENT_MAX_RETRIES=3
# ORTHOMOSAIC_CLIENT_RETRY_DELAY_SECONDS=2

# ==============================================
# API Gateway Callback (used by sub-services)
# ==============================================
API_GATEWAY_CALLBACK_ENDPOINT=/jobs/subservice-callback
API_GATEWAY_TIMEOUT_SECONDS=30

# ==============================================
# Backend Integration
# ==============================================
BACKEND_API_URL=http://backend:8000
BACKEND_CALLBACK_ENDPOINT=/v1/api/jobs/ai-callback/
BACKEND_API_SECRET_KEY=your-secret-key-here

# ==============================================
# Redis Configuration
# ==============================================
# Option A: Individual fields
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Option B: Full URL (takes precedence if set)
# REDIS_URL=redis://:password@redis:6379/0

# ==============================================
# Job State Settings
# ==============================================
JOB_STATE_TTL_HOURS=72
# JOB_STATE_KEY_PREFIX=photogear:job:

# ==============================================
# Background Task Settings
# ==============================================
BACKGROUND_TASK_USE_REDIS=true
BACKGROUND_TASK_CLEANUP_HOURS=24
BACKGROUND_TASK_MAX_CONCURRENT_PIPELINES=1

# ==============================================
# AWS Credentials
# ==============================================
# Set USE_AWS_ROLE=true when running on AWS with ECS Task Role / IAM Profile.
# When true, explicit credentials below are ignored.
USE_AWS_ROLE=false

# S3 credentials (only when USE_AWS_ROLE=false)
AWS_S3_ACCESS_KEY_ID=your-access-key
AWS_S3_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_REGION_NAME=eu-north-1

# ==============================================
# S3 Buckets
# ==============================================
AWS_S3_RAW_IMAGES_BUCKET=photogear-raw-images-bucket
AWS_S3_AI_BUCKET=photogear-production-ai-bucket
AWS_S3_RESULTS_BUCKET=photogear-production-ai-bucket

# ==============================================
# Storage Driver (used by StorageDriverFactory)
# ==============================================
# driver: local | s3 | presigned_url
STORAGE_DRIVER=local
STORAGE_BASE_PATH=/tmp/photogear_storage
STORAGE_BUCKET_NAME=photogear-production-ai-bucket
STORAGE_REGION=eu-north-1
STORAGE_PREFIX=photogear
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_PRESIGNED_URL_TIMEOUT=300

# ==============================================
# Shared Storage Configuration (EFS / Local)
# ==============================================
# mode: local | efs
SHARED_STORAGE_MODE=local

# Local mode settings
TEMP_BASE_PATH=/app/data/temp
TEMP_CLEANUP_DAYS=1

# EFS mode settings (only when SHARED_STORAGE_MODE=efs)
EFS_FILE_SYSTEM_ID=
EFS_MOUNT_POINT=/app/data/temp
EFS_AWS_REGION=eu-north-1
EFS_ACCESS_KEY_ID=your-efs-access-key
EFS_SECRET_ACCESS_KEY=your-efs-secret-key

# ==============================================
# Job Dispatch Mode
# ==============================================
# http: API gateway calls services directly via HTTP (default, local dev)
# sqs:  API gateway publishes jobs to SQS queues (production autoscaling)
DISPATCH_MODE=http

# ==============================================
# SQS Configuration (only when DISPATCH_MODE=sqs)
# ==============================================
SQS_ENABLED=false
SQS_REGION_NAME=eu-north-1
SQS_ACCESS_KEY_ID=your-sqs-access-key
SQS_SECRET_ACCESS_KEY=your-sqs-secret-key
SQS_USE_AWS_ROLE=false

# Queue URLs (one per processing service)
SQS_CALIBRATION_QUEUE_URL=
SQS_SFM_QUEUE_URL=
SQS_ORTHOMOSAIC_QUEUE_URL=

# Dead-letter queue URLs (for failed messages)
SQS_CALIBRATION_DLQ_URL=
SQS_SFM_DLQ_URL=
SQS_ORTHOMOSAIC_DLQ_URL=

# Consumer polling settings
SQS_POLL_INTERVAL_SECONDS=5
SQS_VISIBILITY_TIMEOUT=3600
SQS_MAX_MESSAGES_PER_POLL=1
SQS_WAIT_TIME_SECONDS=20

# ==============================================
# Logging Configuration
# ==============================================
APPLICATION_LEVEL=Development
ENABLE_TRACING=true
ENABLE_FILE_LOGGING=true
IGNORE_NAN_TRACE=false

# ==============================================
# COLMAP Configuration
# ==============================================

# STEP 1: Feature Extraction Settings
COLMAP_CAMERA_MODEL=OPENCV
COLMAP_SINGLE_CAMERA=1
COLMAP_FEATURE_EXTRACTION_MAX_IMAGE_SIZE=1000
COLMAP_SEED_FACTORY_INTRINSICS=false
COLMAP_SIFT_MAX_NUM_FEATURES=16384
COLMAP_SIFT_ESTIMATE_AFFINE_SHAPE=1
COLMAP_SIFT_DOMAIN_SIZE_POOLING=1
COLMAP_SIFT_UPRIGHT=0
COLMAP_FEATURE_EXTRACTION_NUM_THREADS=-1
COLMAP_FEATURE_EXTRACTION_USE_GPU=1
COLMAP_FEATURE_EXTRACTION_GPU_INDEX=0

# STEP 2: Feature Matching Settings
COLMAP_MATCHER_TYPE=spatial
COLMAP_SEQUENTIAL_OVERLAP=25
COLMAP_SEQUENTIAL_QUADRATIC_OVERLAP=1
COLMAP_SEQUENTIAL_LOOP_DETECTION=1
COLMAP_SEQUENTIAL_LOOP_DETECTION_NUM_IMAGES=20
COLMAP_SEQUENTIAL_VOCAB_TREE_PATH=/usr/local/share/colmap/vocab_tree_flickr100K_words256K.bin  # container path (baked in image or mounted via volume)
COLMAP_VOCAB_TREE_HOST_PATH=./data/vocab_tree_faiss_flickr100K_words256K.bin  # host path to mount into the container
COLMAP_MATCHING_GUIDED_MATCHING=1
COLMAP_MATCHING_MAX_NUM_MATCHES=65536
COLMAP_MATCHING_MAX_RATIO=0.75
COLMAP_MATCHING_MAX_DISTANCE=0.65
COLMAP_MATCHING_CROSS_CHECK=1
COLMAP_MATCHING_MAX_ERROR=4.0
COLMAP_MATCHING_CONFIDENCE=0.999
COLMAP_MATCHING_MIN_INLIER_RATIO=0.20
COLMAP_MATCHING_MIN_NUM_INLIERS=20
COLMAP_MATCHING_USE_GPU=1
COLMAP_MATCHING_GPU_INDEX=0

# STEP 3: Mapper Settings (Sparse Reconstruction)
COLMAP_MAPPER_BA_REFINE_FOCAL_LENGTH=1
COLMAP_MAPPER_BA_REFINE_PRINCIPAL_POINT=1
COLMAP_MAPPER_BA_REFINE_EXTRA_PARAMS=1
COLMAP_MAPPER_BA_GLOBAL_MAX_NUM_ITERATIONS=100
COLMAP_MAPPER_BA_GLOBAL_FRAMES_RATIO=1.2
COLMAP_MAPPER_BA_GLOBAL_POINTS_RATIO=1.2
COLMAP_MAPPER_BA_GLOBAL_MAX_REFINEMENTS=5
COLMAP_MAPPER_BA_LOCAL_MAX_NUM_ITERATIONS=50
COLMAP_MAPPER_BA_LOCAL_MAX_REFINEMENTS=3
COLMAP_MAPPER_MIN_NUM_MATCHES=10
COLMAP_MAPPER_IGNORE_WATERMARKS=0
COLMAP_MAPPER_MULTIPLE_MODELS=1
COLMAP_MAPPER_EXTRACT_COLORS=1
COLMAP_MAPPER_NUM_THREADS=-1
COLMAP_MAPPER_MIN_MODEL_SIZE=5
COLMAP_MAPPER_INIT_MIN_NUM_INLIERS=50
COLMAP_MAPPER_INIT_MAX_ERROR=6.0
COLMAP_MAPPER_INIT_MAX_FORWARD_MOTION=0.95
COLMAP_MAPPER_INIT_MIN_TRI_ANGLE=3.0
COLMAP_MAPPER_ABS_POSE_MAX_ERROR=16.0
COLMAP_MAPPER_ABS_POSE_MIN_NUM_INLIERS=15
COLMAP_MAPPER_ABS_POSE_MIN_INLIER_RATIO=0.15
COLMAP_MAPPER_FILTER_MAX_REPROJ_ERROR=6.0
COLMAP_MAPPER_FILTER_MIN_TRI_ANGLE=1.0
COLMAP_MAPPER_MAX_REG_TRIALS=5
COLMAP_MAPPER_FIX_EXISTING_FRAMES=0
COLMAP_MAPPER_BA_USE_GPU=1
COLMAP_MAPPER_BA_GPU_INDEX=0
COLMAP_MAPPER_MIN_ANGLE=1.0
COLMAP_MAPPER_COMPLETE_MAX_REPROJ_ERROR=6.0
COLMAP_MAPPER_CREATE_MAX_ANGLE_ERROR=3.0
COLMAP_MAPPER_BA_LOCAL_NUM_IMAGES=10
COLMAP_MAPPER_USE_PRIOR_POSITION=1
# GPS alignment is handled by model_aligner (geo_register step) AFTER reconstruction.
# Glomap must stay in visual-only mode (ONLY_POINTS) so stereo pair generation works.
# Only change to POINTS_AND_CAMERAS_BALANCED if your pycolmap version stores
# prior_t in a metric coordinate system (ECEF) — NOT lat/lon/alt degrees.
COLMAP_GLOMAP_CONSTRAINT_TYPE=ONLY_POINTS

# STEP 4: Bundle Adjustment Settings
COLMAP_BA_MAX_NUM_ITERATIONS=100
COLMAP_BA_REFINE_FOCAL_LENGTH=1
COLMAP_BA_REFINE_PRINCIPAL_POINT=1
COLMAP_BA_REFINE_EXTRA_PARAMS=1
COLMAP_BA_USE_GPU=1
COLMAP_BA_GPU_INDEX=0

# STEP 4.5: Geo-Registration Settings
# Aligns the COLMAP sparse model to real-world ECEF coordinates using GPS EXIF priors.
# Runs colmap model_aligner --alignment_type gps after bundle adjustment.
# Maximum reprojection error (metres) for GPS alignment — increase if GPS is noisy.
COLMAP_GEO_REGISTRATION_MAX_ERROR=3.0

# STEP 5: Image Undistortion Settings
COLMAP_UNDISTORT_MAX_IMAGE_SIZE=1000
COLMAP_UNDISTORT_OUTPUT_TYPE=COLMAP

# STEP 6: Dense Reconstruction Settings
COLMAP_PATCH_MATCH_MAX_IMAGE_SIZE=1000
COLMAP_PATCH_MATCH_WINDOW_RADIUS=5
COLMAP_PATCH_MATCH_WINDOW_STEP=1
COLMAP_PATCH_MATCH_NUM_SAMPLES=5
COLMAP_PATCH_MATCH_NUM_ITERATIONS=3
COLMAP_PATCH_MATCH_GEOM_CONSISTENCY=1
COLMAP_PATCH_MATCH_GEOM_CONSISTENCY_REGULARIZER=0.3
COLMAP_PATCH_MATCH_GEOM_CONSISTENCY_MAX_COST=3.0
COLMAP_PATCH_MATCH_FILTER=1
COLMAP_PATCH_MATCH_FILTER_MIN_NCC=0.1
COLMAP_PATCH_MATCH_FILTER_MIN_TRIANGULATION_ANGLE=1.0
COLMAP_PATCH_MATCH_FILTER_MIN_NUM_CONSISTENT=2
COLMAP_PATCH_MATCH_FILTER_GEOM_CONSISTENCY_MAX_COST=1.0
COLMAP_PATCH_MATCH_CACHE_SIZE=32
COLMAP_PATCH_MATCH_GPU_INDEX=0

# Stereo Fusion Settings
COLMAP_FUSION_NUM_THREADS=-1
COLMAP_FUSION_MAX_IMAGE_SIZE=1000
COLMAP_FUSION_MIN_NUM_PIXELS=5
COLMAP_FUSION_MAX_NUM_PIXELS=10000
COLMAP_FUSION_MAX_TRAVERSAL_DEPTH=100
COLMAP_FUSION_MAX_REPROJ_ERROR=2.0
COLMAP_FUSION_MAX_DEPTH_ERROR=0.05
COLMAP_FUSION_MAX_NORMAL_ERROR=10.0
COLMAP_FUSION_CHECK_NUM_IMAGES=50
COLMAP_FUSION_USE_CACHE=1
COLMAP_FUSION_CACHE_SIZE=32

# Meshing Settings
COLMAP_POISSON_DEPTH=13
COLMAP_POISSON_TRIM=7.0
COLMAP_MESHER_TRIM=10.0
# Minimum fused points required before running Poisson meshing.
# poisson_mesher crashes (SIGSEGV) on an empty point cloud.
COLMAP_MESH_MIN_POINTS=100

# ==============================================
# Orthomosaic Generation Configuration
# ==============================================
# All prefixed with ORTHOMOSAIC_

# DSM generation
ORTHOMOSAIC_DSM_RESOLUTION=0.05
ORTHOMOSAIC_DSM_OUTPUT_TYPE=max
ORTHOMOSAIC_DSM_RADIUS=0.5
ORTHOMOSAIC_PDAL_THREADS=0

# Hole filling
ORTHOMOSAIC_FILL_MAX_DISTANCE=100
ORTHOMOSAIC_FILL_SMOOTHING_ITERATIONS=0

# Cloud Optimized GeoTIFF (COG)
ORTHOMOSAIC_COG_COMPRESSION=LZW
ORTHOMOSAIC_COG_PREDICTOR=2
ORTHOMOSAIC_COG_BLOCKSIZE=512
ORTHOMOSAIC_COG_OVERVIEW_RESAMPLING=AVERAGE

# Orthophoto
ORTHOMOSAIC_ORTHO_RESOLUTION=0.05
ORTHOMOSAIC_ORTHO_INTERPOLATION=bilinear

# Orthorectify MS bands through SFM RGB poses + DSM (fixes puzzle-piece tile
# misplacement). Auto-falls back to GPS warping if SFM pose artifacts are absent.
ORTHO_USE_POSE_ORTHO=false


# GDAL threading (applies to COG creation, warping, merge, hillshade, etc.)
# Set to ALL_CPUS to use all cores, or a number (e.g. 4) for a specific count.
GDAL_NUM_THREADS=ALL_CPUS

# ==============================================
# Radiometric Calibration Configuration
# ==============================================
# Callback to API Gateway (shared with other sub-services)
# API_GATEWAY_URL=http://api_gateway:8080
# API_GATEWAY_CALLBACK_ENDPOINT=/jobs/subservice-callback
# API_GATEWAY_TIMEOUT_SECONDS=30

# S3 bucket for calibration outputs
# AWS_S3_AI_BUCKET=photogear-production-ai-bucket

# ==============================================
# Product Upload Configuration
# ==============================================
# Upload chunk timeout and retry (used by API Gateway)
# BACKEND_CHUNK_TIMEOUT_SECONDS=600
# BACKEND_CHUNK_MAX_RETRIES=3
# BACKEND_CHUNK_RETRY_DELAY_SECONDS=5.0

# ==============================================
# Benchmark Configuration
# ==============================================
# All values can be overridden via CLI: python -m benchmark --help
BENCHMARK_DATASET_PATH=./data/images
BENCHMARK_OUTPUT_PATH=./benchmark_results
# BENCHMARK_GROUND_TRUTH_PATH=./data/ground_truth
BENCHMARK_GPU_COUNT=1
BENCHMARK_NUM_RUNS=1
BENCHMARK_TIMEOUT_SECONDS=3600
BENCHMARK_GATEWAY_URL=http://localhost:8080
BENCHMARK_RUN_STAGES=all
# BENCHMARK_TARGET_GSD=2.5
# BENCHMARK_MAX_IMAGE_SIZE=3000

# Validation thresholds
BENCHMARK_CHECKPOINT_RMSE_H_THRESHOLD=0.10
BENCHMARK_CHECKPOINT_RMSE_V_THRESHOLD=0.15
BENCHMARK_RADIOMETRIC_R2_THRESHOLD=0.85
BENCHMARK_REPRODUCIBILITY_THRESHOLD=0.99
BENCHMARK_GSD_ACCURACY_THRESHOLD=0.05
